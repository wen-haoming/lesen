# Optional self-hosted account sync. Leave blank for the default local-only build.
# First set OWLIVO_SUPABASE_PROJECT_REF in src/lib/owlivo-auth-config.ts to YOUR project ref.
WXT_PUBLIC_SUPABASE_URL=
WXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
WXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
# Public configuration only. NEVER put service-role keys, OAuth secrets or release tokens here.
